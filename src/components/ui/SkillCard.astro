---
import Icon from './Icon.astro';
import type { SkillCategory } from '../../types';

interface Props {
  skill: SkillCategory;
  /** Stagger delay in ms applied as transition-delay (0 = none). */
  delay?: number;
}
const { skill, delay = 0 } = Astro.props;
---
<div
  class="glass-card p-10 rounded-2xl group hover:border-[#E7A51A] transition-all duration-500 relative overflow-hidden gsap-fade-up"
  style={delay ? `transition-delay:${delay}ms` : undefined}
>
  <div class="inner-glow"></div>
  <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-all duration-700 bg-gradient-to-br from-[#E7A51A]/10 via-transparent to-transparent z-0"></div>
  <Icon id={skill.icon} class="w-10 h-10 text-[#E7A51A] mb-8 relative z-10" />
  <h3 class="text-xl md:text-2xl text-white mb-6 font-montserrat font-bold tracking-[0.15em] uppercase relative z-10">{skill.title}</h3>
  <ul class="flex flex-col gap-4 font-mono-code text-xs md:text-sm text-white/55 uppercase tracking-wide relative z-10">
    {skill.items.map((item) => <li>• {item}</li>)}
  </ul>
</div>
