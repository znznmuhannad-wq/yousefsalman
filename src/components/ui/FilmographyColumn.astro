---
import type { FilmographyColumn } from '../../types';

interface Props {
  column: FilmographyColumn;
  /** Stagger delay in ms applied as transition-delay (0 = none). */
  delay?: number;
}
const { column, delay = 0 } = Astro.props;
---
<div class="gsap-fade-up glass-card p-8 rounded-2xl relative" style={delay ? `transition-delay:${delay}ms` : undefined}>
  <div class="inner-glow"></div>
  <h3 class={`text-lg md:text-xl ${column.accentHeading ? 'text-[#E7A51A]' : 'text-white'} font-montserrat font-bold tracking-[0.1em] uppercase mb-6 border-b border-[rgba(255,255,255,0.08)] pb-4 relative z-10`}>{column.title}</h3>
  <ul class="flex flex-col relative z-10">
    {column.entries.map((entry) => (
      <li class="flex justify-between items-center py-4 border-b border-[rgba(255,255,255,0.05)] last:border-0 group cursor-default">
        <span class="text-white/55 font-mono-code text-sm tracking-wide group-hover:text-white transition-colors">{entry.name}</span>
        <span class={`text-[10px] ${entry.accentTag ? 'text-[#E7A51A]' : 'text-white/40'} font-mono-code tracking-widest uppercase ml-4 text-right`}>{entry.tag}</span>
      </li>
    ))}
  </ul>
</div>
