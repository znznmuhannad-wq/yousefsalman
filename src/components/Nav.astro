---
import { navLinks } from '../data/nav';
---
<nav class="fixed top-0 left-0 w-full p-4 md:p-8 z-200 flex justify-between items-start mix-blend-difference pointer-events-none">
  <div class="relative flex flex-col pointer-events-auto">
    <button id="menu-toggle" class="font-credits text-lg md:text-xl tracking-[0.3em] font-bold text-white hover:text-[#E7A51A] transition-colors flex items-center gap-2 focus:outline-none" aria-haspopup="true" aria-expanded="false" aria-controls="dropdown-menu">
      YS.CUT
      <svg class="w-4 h-4 transition-transform duration-300" id="menu-arrow" aria-hidden="true"><use href="#i-chevron-down" /></svg>
    </button>

    <div id="dropdown-menu" class="absolute top-0 mt-4 left-0 bg-[#050505]/95 backdrop-blur-xl border border-[rgba(255,255,255,0.08)] rounded-xl overflow-hidden opacity-0 pointer-events-none transition-all duration-300 z-210 shadow-2xl" style="top:100%;width:12rem;transform:translateY(-1rem)">
      <ul class="flex flex-col py-2 font-mono-code text-xs tracking-[0.2em] uppercase text-white/70">
        {navLinks.map((link) => (
          <li><a href={link.href} class="block px-6 py-3 hover:bg-white/5 hover:text-[#E7A51A] transition-colors">{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="flex items-center gap-6 pointer-events-auto mt-1 md:mt-0">
    <div class="hidden md:flex items-center gap-4">
      <div class="font-credits text-[10px] tracking-[0.2em] border border-white/30 px-3 py-1 rounded-full text-white/70" style="border-radius:9999px">
        WORLDWIDE PROJECTS
      </div>
    </div>
    <div class="flex items-center gap-2">
      <div class="w-2 h-2 bg-[#E7A51A] rounded-full animate-pulse"></div>
      <span class="font-mono-code text-sm">LIVE</span>
    </div>
  </div>
</nav>
