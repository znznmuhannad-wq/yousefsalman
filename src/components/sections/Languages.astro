---
/** Languages band between Filmography and Contact. */
---
<section class="py-16 bg-[#050505] border-t border-[rgba(255,255,255,0.08)]">
  <div class="container mx-auto px-5 md:px-12">
    <div class="glass-card max-w-lg mx-auto p-8 rounded-2xl flex flex-col items-center justify-center relative">
      <div class="inner-glow"></div>
      <p class="font-montserrat font-bold text-[10px] tracking-[0.3em] text-white/55 mb-6 uppercase relative z-10">Languages</p>
      <div class="flex justify-center items-center gap-6 text-white text-lg md:text-xl font-montserrat font-bold tracking-[0.2em] uppercase relative z-10">
        <span>ARABIC</span>
        <span class="text-[#E7A51A]">/</span>
        <span>ENGLISH</span>
      </div>
    </div>
  </div>
</section>
