---
/** Site footer. */
---
<footer class="bg-[#050505] py-20 text-center border-t border-[rgba(255,255,255,0.08)]">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl sm:text-5xl md:text-6xl text-white font-montserrat font-black uppercase tracking-[0.2em] mb-8">YOUSEF SALMAN</h2>
    <p class="text-white/55 font-mono-code text-xs md:text-sm mb-12 tracking-[0.3em] uppercase">Creative Filmmaker | Cinematographer | Visual Storyteller</p>

    <div class="flex justify-center gap-8 mb-12">
      <span class="w-1.5 h-1.5 bg-[#E7A51A] rounded-full"></span>
      <span class="w-1.5 h-1.5 bg-[rgba(255,255,255,0.2)] rounded-full"></span>
      <span class="w-1.5 h-1.5 bg-[rgba(255,255,255,0.2)] rounded-full"></span>
    </div>

    <p class="text-white/40 text-[10px] md:text-xs tracking-[0.4em] uppercase font-mono-code">© 2025 THE Y.S CUT • ALL RIGHTS RESERVED</p>
  </div>
</footer>
