---
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';
import { site, personJsonLd } from '../data/site';
import { hero } from '../data/hero';

/**
 * Document shell: head metadata, fonts, structured data, the global stylesheet,
 * the fixed film-grain overlay and the inline SVG icon sprite. Page content is
 * provided via <slot />. Compiles to static HTML with a single deferred module.
 */
const canonical = new URL(Astro.url.pathname, site.url).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- A11Y: dropped maximum-scale/user-scalable=no so pinch-zoom works (WCAG 1.4.4). -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{site.title}</title>
  <meta name="description" content={site.description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:title" content={site.ogTitle} />
  <meta property="og:description" content={site.ogDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={site.url} />
  <meta property="og:image" content={site.ogImage} />

  <!-- SEO: Twitter card (new) -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={site.ogTitle} />
  <meta name="twitter:description" content={site.ogDescription} />
  <meta name="twitter:image" content={site.ogImage} />

  <link rel="icon" type="image/png" sizes="16x16" href="https://i.ibb.co/G6G6LZ4/16.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="https://i.ibb.co/4nKCGjsL/32.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="https://i.ibb.co/LXnxw0jD/48.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="https://i.ibb.co/GQLvSHjP/192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="https://i.ibb.co/mrLrCwjk/42.png" />

  <!-- PERF: Preconnect to image CDN for faster first image -->
  <link rel="preconnect" href="https://i.ibb.co" crossorigin />
  <link rel="dns-prefetch" href="https://i.ibb.co" />

  <!-- PERF: Preload hero image with high priority for LCP -->
  <link rel="preload" as="image" href={hero.bgImage} fetchpriority="high" />

  <!-- PERF: One combined Google Fonts request, only the weights actually used.
       font-display: swap prevents invisible text during load. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Anton&family=Caveat:wght@700&family=Inter:wght@400;700&family=Montserrat:wght@900&family=Oswald:wght@300;500&family=Space+Mono:wght@400;700&display=swap"
    rel="stylesheet"
  />

  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} is:inline />

  <!-- A11Y: with JS disabled, reveal-on-scroll elements must remain visible. -->
  <noscript>
    <style>
      .gsap-reveal-left,.gsap-reveal-right,.gsap-fade-up,.gsap-scale-in{
        opacity:1 !important;transform:none !important;
      }
    </style>
  </noscript>
</head>
<body>
  <div class="film-grain" aria-hidden="true"></div>

  <IconSprite />

  <slot />

  <script>
    import '../scripts/main.ts';
  </script>
</body>
</html>
